# PostgreSQL (psycopg 3 driver). For quick local experiments only you may use sqlite:///./goals.db
DATABASE_URL=postgresql+psycopg://goals:goals@localhost:5432/goals

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini (leave empty to use the built-in rule-based planner)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
AI_RATE_LIMIT_PER_HOUR=20

# Background notification scheduler (disable on extra API replicas)
ENABLE_SCHEDULER=true

# Initial administrator, created on first start if no admin exists. Change the password after login.
ADMIN_EMAIL=admin@goals.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Administrator
